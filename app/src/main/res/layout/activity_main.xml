<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="28dp" android:paddingEnd="22dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="68dp" android:layout_height="68dp" android:contentDescription="Gummy 外教翻译图标" android:src="@drawable/ic_launcher_art" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/PaperTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="外教课翻译" />
                    <TextView android:id="@+id/greetingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="让每一句都听得明白" android:textColor="@color/text_secondary" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_paper_card" android:elevation="2dp" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日课堂" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="serif" android:text="English  →  中文" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/readinessText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="检查设置中…" android:textColor="@color/text_secondary" android:textSize="14sp" />
                <com.gummytranslate.app.CenteredIconButton android:id="@+id/startClassButton" style="@style/PaperButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="22dp" android:drawableStart="@drawable/ic_mic" android:drawablePadding="9dp" android:drawableTint="@color/surface" android:elevation="3dp" android:text="开始课堂" />
            </LinearLayout>
            <LinearLayout android:id="@+id/latestCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_paper_card" android:clickable="true" android:elevation="1dp" android:focusable="true" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/PaperSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最近一次" />
                <TextView android:id="@+id/latestTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="还没有课程记录" android:textColor="@color/text_primary" android:textSize="16sp" />
                <TextView android:id="@+id/latestDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="完成第一节课后会显示在这里" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/surface_card" android:orientation="horizontal">
        <Button style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_home" android:drawablePadding="6dp" android:drawableTint="@color/primary_dark" android:enabled="false" android:text="首页" android:textColor="@color/primary_dark" />
        <Button android:id="@+id/historyNav" style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_history" android:drawablePadding="6dp" android:drawableTint="@color/text_secondary" android:text="课程记录" />
        <Button android:id="@+id/settingsNav" style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_settings" android:drawablePadding="6dp" android:drawableTint="@color/text_secondary" android:text="设置" />
    </LinearLayout>
</LinearLayout>
