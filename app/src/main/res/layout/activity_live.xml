<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/backButton" style="@style/PaperNavButton" android:layout_width="wrap_content" android:layout_height="48dp" android:drawableStart="@drawable/ic_back" android:drawablePadding="4dp" android:drawableTint="@color/text_secondary" android:text="返回" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="serif" android:gravity="center" android:text="正在上课" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/timerText" android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="end" android:text="00:00" android:textColor="@color/text_secondary" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <View android:id="@+id/statusDot" android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/bg_status_dot" />
        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="正在准备…" android:textColor="@color/text_secondary" android:textSize="14sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp" android:clipChildren="true" android:clipToPadding="true">
        <ListView android:id="@+id/captionList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:listSelector="@android:color/transparent" android:divider="@android:color/transparent" android:dividerHeight="12dp" android:paddingBottom="12dp" android:stackFromBottom="true" android:transcriptMode="disabled" />
        <Button android:id="@+id/jumpToLatestButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:layout_margin="12dp" android:alpha="0.78" android:background="@drawable/bg_jump_latest" android:elevation="6dp" android:gravity="center" android:padding="0dp" android:text="↓" android:textColor="@color/surface" android:textSize="24sp" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="216dp" android:layout_marginTop="10dp" android:background="@drawable/bg_paper_card" android:clipChildren="true" android:elevation="2dp" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/englishText" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fadeScrollbars="true" android:gravity="bottom" android:includeFontPadding="false" android:lineSpacingExtra="1dp" android:overScrollMode="never" android:paddingBottom="8dp" android:scrollbars="vertical" android:text="等待外教说话…" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="15sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
        <TextView android:id="@+id/chineseText" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.12" android:fadeScrollbars="true" android:fontFamily="serif" android:gravity="bottom" android:includeFontPadding="false" android:lineSpacingExtra="2dp" android:overScrollMode="never" android:paddingTop="8dp" android:scrollbars="vertical" android:text="等待翻译…" android:textColor="@color/text_primary" android:textIsSelectable="true" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <com.gummytranslate.app.CenteredIconButton android:id="@+id/pauseButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_secondary_button" android:drawableStart="@drawable/ic_pause" android:drawablePadding="8dp" android:drawableTint="@color/primary_dark" android:text="暂停" android:textColor="@color/primary_dark" android:textAllCaps="false" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <com.gummytranslate.app.CenteredIconButton android:id="@+id/endButton" style="@style/PaperButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:drawableStart="@drawable/ic_stop" android:drawablePadding="8dp" android:drawableTint="@color/surface" android:text="结束课堂" />
    </LinearLayout>
</LinearLayout>
