<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="28dp" android:paddingEnd="22dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/PaperTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="课程记录" />
            <Button android:id="@+id/clearHistoryButton" style="@style/PaperNavButton" android:layout_width="wrap_content" android:layout_height="48dp" android:drawableStart="@drawable/ic_delete" android:drawablePadding="5dp" android:drawableTint="@color/error" android:text="清空" android:textColor="@color/error" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="每一堂课，都是一本正在写的笔记" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <ListView android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="20dp" android:divider="@android:color/transparent" android:dividerHeight="12dp" />
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="还没有课程记录\n开始第一堂外教课吧" android:textColor="@color/text_secondary" android:textSize="16sp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/surface_card" android:orientation="horizontal">
        <Button android:id="@+id/homeNav" style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_home" android:drawablePadding="6dp" android:drawableTint="@color/text_secondary" android:text="首页" />
        <Button style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_history" android:drawablePadding="6dp" android:drawableTint="@color/primary_dark" android:enabled="false" android:text="课程记录" android:textColor="@color/primary_dark" />
        <Button android:id="@+id/settingsNav" style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_settings" android:drawablePadding="6dp" android:drawableTint="@color/text_secondary" android:text="设置" />
    </LinearLayout>
</LinearLayout>
