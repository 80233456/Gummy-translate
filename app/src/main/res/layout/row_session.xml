<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_paper_card" android:elevation="1dp" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/sessionTitle" style="@style/PaperSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/deleteSessionButton" style="@style/PaperNavButton" android:layout_width="wrap_content" android:layout_height="42dp" android:drawableStart="@drawable/ic_delete" android:drawablePadding="4dp" android:drawableTint="@color/error" android:focusable="false" android:text="删除" android:textColor="@color/error" />
    </LinearLayout>
    <TextView android:id="@+id/sessionDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <TextView android:id="@+id/sessionPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="15sp" />
</LinearLayout>
