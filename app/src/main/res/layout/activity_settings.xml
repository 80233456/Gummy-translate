<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="28dp" android:paddingEnd="22dp" android:paddingBottom="24dp">
            <TextView style="@style/PaperTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="保持简单，也保持可靠" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_paper_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/PaperSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="阿里云百炼" />
                <EditText android:id="@+id/apiKeyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:autofillHints="password" android:hint="API Key" android:inputType="textPassword" android:maxLines="1" />
                <CheckBox android:id="@+id/showKeyCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="显示 Key" />
                <Button android:id="@+id/testKeyButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_secondary_button" android:text="保存并测试连接" android:textAllCaps="false" android:textColor="@color/primary_dark" />
                <TextView android:id="@+id/keyStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="尚未测试" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_paper_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/PaperSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="课堂偏好" />
                <CheckBox android:id="@+id/keepScreenCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:checked="true" android:text="课堂中保持屏幕常亮" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="断句灵敏度" android:textColor="@color/text_primary" android:textSize="15sp" />
                <Spinner android:id="@+id/silenceSpinner" android:layout_width="match_parent" android:layout_height="48dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="实时字幕字号" android:textColor="@color/text_primary" android:textSize="15sp" />
                <Spinner android:id="@+id/textSizeSpinner" android:layout_width="match_parent" android:layout_height="48dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="英语 → 中文 · gummy-realtime-v1" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_paper_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/PaperSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="麦克风增强" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="使用手机内置音频处理，不上传额外数据" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <CheckBox android:id="@+id/noiseSuppressionCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="环境降噪（推荐）" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="声音场景预设" android:textColor="@color/text_primary" android:textSize="15sp" />
                <Spinner android:id="@+id/micGainSpinner" android:layout_width="match_parent" android:layout_height="48dp" />
                <CheckBox android:id="@+id/echoCancellationCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="回声消除（出现扬声器回声时开启）" />
                <CheckBox android:id="@+id/autoGainCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="自动增益（声音过小时使用）" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="翻译本机或教室外放视频时请关闭回声消除；自适应增益会提升轻声并自动防止爆音。" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/audioSupportText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/surface_card" android:orientation="horizontal">
        <Button android:id="@+id/homeNav" style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_home" android:drawablePadding="6dp" android:drawableTint="@color/text_secondary" android:text="首页" />
        <Button android:id="@+id/historyNav" style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_history" android:drawablePadding="6dp" android:drawableTint="@color/text_secondary" android:text="课程记录" />
        <Button style="@style/PaperNavButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:drawableStart="@drawable/ic_settings" android:drawablePadding="6dp" android:drawableTint="@color/primary_dark" android:enabled="false" android:text="设置" android:textColor="@color/primary_dark" />
    </LinearLayout>
</LinearLayout>
